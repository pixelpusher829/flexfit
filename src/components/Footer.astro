---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import logoLight from "../images/logo-light.png";
import { business, fullAddress, mapsHref, nav, phoneHref } from "../data/site";
import { withBase } from "../lib/url";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<Image src={logoLight} alt={business.name} height={48} width={Math.round((48 * logoLight.width) / logoLight.height)} />
			<p>{business.tagline}. Start with a free intro session and a coach who actually knows your name.</p>
			<ul class="social">
				{
					business.social.map((s) => (
						<li>
							<a href={s.href} target="_blank" rel="noopener noreferrer">
								<Icon name={s.icon} label={s.label} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h2 class="footer-heading">Explore</h2>
			<ul class="footer-links">
				{
					nav.map((item) => (
						<li>
							<a href={withBase(`/${item.href}`)}>{item.label}</a>
						</li>
					))
				}
				<li><a href={withBase("/#contact")}>Contact</a></li>
			</ul>
		</div>
		<div>
			<h2 class="footer-heading">Visit us</h2>
			<ul class="footer-links footer-contact">
				<li><Icon name="pin" /><a href={mapsHref} target="_blank" rel="noopener noreferrer">{fullAddress}</a></li>
				<li><Icon name="phone" /><a href={phoneHref}>{business.phone}</a></li>
				<li><Icon name="mail" /><a href={`mailto:${business.email}`}>{business.email}</a></li>
			</ul>
		</div>
		<div>
			<h2 class="footer-heading">Hours</h2>
			<dl class="hours">
				{
					business.hours.map((h) => (
						<div>
							<dt>{h.days}</dt>
							<dd>{h.time}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
	<div class="footer-bottom">
		<div class="container">
			<p>© {year} {business.name}. All rights reserved.</p>
			<a href={withBase("/privacy/")}>Privacy policy</a>
		</div>
	</div>
</footer>
