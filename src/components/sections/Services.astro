---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import { business, phoneHref, services } from "../../data/site";
---

<section class="section section-tint" id="services" aria-labelledby="services-title">
	<div class="container">
		<header class="section-head" data-reveal>
			<p class="eyebrow">What we offer</p>
			<h2 id="services-title">Services built around your goals</h2>
			<p>Mix and match coaching, classes and nutrition support. Every membership starts with a free intro session.</p>
		</header>
		<ul class="service-grid">
			{
				services.map((s) => (
					<li class="card service-card" id={s.id} data-reveal>
						<Image src={s.image} alt={s.alt} widths={[400, 640]} sizes="(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw" />
						<div class="card-body">
							<h3>{s.title}</h3>
							<p>{s.summary}</p>
							<ul class="checklist">
								{s.points.map((p) => (
									<li>
										<Icon name="check" size={18} />
										{p}
									</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
			<li class="service-cta" data-reveal>
				<span class="service-cta-icon"><Icon name="message" size={24} /></span>
				<h3>Not sure where to start?</h3>
				<p>Tell us your goals and a coach will recommend the right mix for you. No pressure, no sales pitch.</p>
				<a href="#contact" class="button button-outline" data-interest="Free intro session">Talk to a coach <Icon name="arrow" size={18} /></a>
				<p class="service-cta-alt">or call <a href={phoneHref}>{business.phone}</a></p>
			</li>
		</ul>
	</div>
</section>
